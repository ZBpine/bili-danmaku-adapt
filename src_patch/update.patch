+function normalizeHexColorStr(s) {
+    const str = String(s || "").trim().toLowerCase();
+    if (!str) return null;
+    if (str.startsWith("#")) {
+        if (str.length === 4) return `#${str[1]}${str[1]}${str[2]}${str[2]}${str[3]}${str[3]}`;
+        if (str.length === 7) return str;
+    }
+    return null;
+}
+
+function parseCssColorToRgb(s) {
+    const str = String(s || "").trim();
+    if (!str) return null;
+
+    const hex = normalizeHexColorStr(str);
+    if (hex) return parseHexToRgb(hex);
+
+    const m = /^rgba?\(\s*(\d+)\s*,\s*(\d+)\s*,\s*(\d+)(?:\s*,\s*([\d.]+))?\s*\)$/i.exec(str);
+    if (!m) return null;
+
+    const r = clampNumber(m[1], 0, 255, 0);
+    const g = clampNumber(m[2], 0, 255, 0);
+    const b = clampNumber(m[3], 0, 255, 0);
+    return [r, g, b];
+}
